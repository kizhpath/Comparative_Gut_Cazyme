name: metagenome
channels:
  - conda-forge
  - bioconda
  - nodefaults
dependencies:
  # Workflow & Metagenomic Profiling
  - snakemake=9.27.1
  - fastp=1.4.0
  - kraken2=2.17.2
  - bracken=3.1
  - diamond=2.2.8

  # R Statistical Environment (CoDA & PERMANOVA)
  - r-base=4.5.3
  - r-vegan=2.7_5
  - r-dplyr=1.2.1
  - r-ggplot2=4.0.3
  - r-tibble

  # Python Visualization Environment
  - python=3.14.10
  - pandas=2.3.3
  - matplotlib=3.11.2
  - seaborn=0.13.2
  - numpy
